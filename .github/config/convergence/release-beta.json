{
  "schema": {
    "version": 8
  },
  "resources": {
    "repository-validation": {
      "paths": [
        "*"
      ],
      "exclude": [
        "apps/packaged/package.json"
      ]
    },
    "packaged-execution": {
      "json": "apps/packaged/package.json",
      "omit": [
        "version"
      ]
    },
    "source-common": {
      "paths": [
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "packages/",
        "tools/pack/",
        "scripts/postinstall.mjs",
        ".github/scripts/release/workspace-products.ts",
        ".github/actions/setup-workspace/"
      ],
      "exclude": [
        "**/tests/**",
        "**/*.test.ts",
        "**/vitest.config.ts",
        "**/tsconfig.tests.json"
      ]
    },
    "source-daemon": {
      "paths": [
        "apps/daemon/"
      ],
      "exclude": [
        "**/tests/**",
        "**/*.test.ts",
        "**/vitest.config.ts",
        "**/tsconfig.tests.json"
      ]
    },
    "source-web": {
      "paths": [
        "apps/web/"
      ],
      "exclude": [
        "**/tests/**",
        "**/*.test.ts",
        "**/vitest.config.ts",
        "**/tsconfig.tests.json"
      ]
    },
    "source-shell": {
      "paths": [
        "apps/desktop/",
        "apps/packaged/"
      ],
      "exclude": [
        "**/tests/**",
        "**/*.test.ts",
        "**/vitest.config.ts",
        "**/tsconfig.tests.json",
        "apps/packaged/package.json"
      ]
    },
    "daemon-dependencies": {
      "paths": [
        "packages/agui-adapter/",
        "packages/contracts/",
        "packages/diagnostics/",
        "packages/launcher-proto/",
        "packages/platform/",
        "packages/plugin-runtime/",
        "packages/registry-protocol/",
        "packages/release/",
        "packages/sidecar/",
        "packages/sidecar-proto/"
      ],
      "exclude": [
        "**/tests/**",
        "**/vitest.config.ts",
        "**/tsconfig.tests.json"
      ]
    },
    "daemon-tests": {
      "paths": [
        "apps/daemon/"
      ],
      "exclude": []
    },
    "test-resources": {
      "paths": [
        "assets/",
        "craft/",
        "design-systems/",
        "design-templates/",
        "plugins/",
        "prompt-templates/",
        "skills/",
        "mocks/"
      ],
      "exclude": []
    },
    "test-environment": {
      "paths": [
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/postinstall.mjs",
        ".github/actions/setup-workspace/"
      ],
      "exclude": []
    },
    "ui-tests": {
      "paths": [
        "apps/web/",
        "apps/desktop/",
        "packages/",
        "tools/dev/",
        "e2e/package.json",
        "e2e/tsconfig.json",
        "e2e/playwright.config.ts",
        "e2e/lib/",
        "e2e/ui/",
        "e2e/resources/",
        "e2e/scripts/",
        ".github/actions/setup-playwright/",
        ".github/actions/configure-ci-parallelism/"
      ],
      "exclude": [
        "apps/web/tests/**",
        "apps/desktop/tests/**",
        "packages/**/tests/**",
        "**/tsconfig.tests.json",
        "**/vitest.config.ts"
      ]
    }
  },
  "suites": {
    "repository-validation": [
      "resource://repository-validation",
      "resource://packaged-execution"
    ],
    "convergence-control": [
      ".github/config/convergence/release-beta.json",
      ".github/scripts/convergence.py",
      ".github/scripts/handoff.py",
      ".github/scripts/lib/",
      ".github/workflows/convergence.atom.yml",
      ".github/workflows/release-beta.yml",
      ".github/actions/setup-workspace/"
    ],
    "source-packages": [
      "resource://source-common"
    ],
    "source-daemon": [
      "resource://source-common",
      "resource://source-daemon"
    ],
    "source-web": [
      "resource://source-common",
      "resource://source-web"
    ],
    "source-shell": [
      "resource://source-common",
      "resource://source-shell",
      "resource://packaged-execution"
    ],
    "daemon-tests": [
      "resource://test-environment",
      "resource://daemon-tests",
      "resource://daemon-dependencies",
      "resource://test-resources"
    ],
    "ui-tests": [
      "resource://test-environment",
      "resource://source-daemon",
      "resource://daemon-dependencies",
      "resource://test-resources",
      "resource://ui-tests"
    ]
  },
  "workflows": {
    "release-beta": {
      "policy": "beta-isolated-v1",
      "workloads": {
        "source_mac_arm64_packages": {
          "successBoundary": "steps",
          "inputs": [
            "suite://source-packages"
          ],
          "runnerClass": "source_mac_arm64",
          "products": "manifest",
          "reusable": true,
          "success": {
            "[build] macOS arm64": [
              "[build] Source packages",
              "[retain] Source products"
            ]
          }
        },
        "source_mac_arm64_daemon": {
          "successBoundary": "steps",
          "inputs": [
            "suite://source-daemon"
          ],
          "runnerClass": "source_mac_arm64",
          "products": "manifest",
          "reusable": true,
          "success": {
            "[build] macOS arm64": [
              "[build] Source daemon",
              "[retain] Source products"
            ]
          }
        },
        "source_mac_arm64_web": {
          "successBoundary": "steps",
          "inputs": [
            "suite://source-web"
          ],
          "runnerClass": "source_mac_arm64",
          "products": "manifest",
          "reusable": true,
          "success": {
            "[build] macOS arm64": [
              "[build] Source web",
              "[retain] Source products"
            ]
          }
        },
        "source_mac_arm64_shell": {
          "successBoundary": "steps",
