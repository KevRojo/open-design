            ]
          }
        },
        "test_e2e_vitest": {
          "inputs": [
            "suite://repository-validation"
          ],
          "runnerClass": "release_tests",
          "products": "none",
          "reusable": true,
          "success": {
            "[test] beta E2E Vitest": [
              "Prepare test dependencies",
              "Run test unit"
            ]
          }
        },
        "test_daemon_unit_tests": {
          "inputs": [
            "suite://daemon-tests"
          ],
          "runnerClass": "release_tests",
          "products": "none",
          "reusable": true,
          "success": {
            "[test] beta Daemon tests (1/4)": [
              "Prepare test dependencies",
              "Run test unit"
            ],
            "[test] beta Daemon tests (2/4)": [
              "Prepare test dependencies",
              "Run test unit"
            ],
            "[test] beta Daemon tests (3/4)": [
              "Prepare test dependencies",
              "Run test unit"
            ],
            "[test] beta Daemon tests (4/4)": [
              "Prepare test dependencies",
              "Run test unit"
            ]
          }
        },
        "test_verify": {
          "inputs": [
            "suite://repository-validation"
          ],
          "runnerClass": "release_tests",
          "products": "none",
          "reusable": true,
          "success": {
            "[test] beta Verify build (typecheck + tests)": [
              "Prepare test dependencies",
              "Run test unit"
            ]
          }
        },
        "test_functional_e2e": {
          "inputs": [
            "suite://ui-tests"
          ],
          "runnerClass": "ui_p0",
          "products": "none",
          "reusable": true,
          "success": {
            "[test] beta UI P0 (entry-settings)": [
              "Prepare test dependencies",
              "Run test unit"
            ],
            "[test] beta UI P0 (project-workspace)": [
              "Prepare test dependencies",
              "Run test unit"
            ],
            "[test] beta UI P0 (project-workspace-editor)": [
              "Prepare test dependencies",
              "Run test unit"
            ],
            "[test] beta UI P0 (project-collab)": [
              "Prepare test dependencies",
              "Run test unit"
            ],
            "[test] beta UI P0 (project-runtime)": [
              "Prepare test dependencies",
              "Run test unit",
              "Run UI critical extras"
            ],
            "[test] beta UI P0 (workspace-restoration)": [
              "Prepare test dependencies",
              "Run test unit"
            ]
          }
        }
      },
      "batches": {
        "source_mac_arm64": {
          "artifact": "beta-source-mac_arm64",
          "entries": {
            "packages": {
              "workload": "source_mac_arm64_packages",
              "request": {
                "units": [
                  "packages"
                ]
              },
              "product": "bundle"
            },
            "daemon": {
              "workload": "source_mac_arm64_daemon",
              "request": {
                "units": [
                  "daemon"
                ]
              },
              "product": "bundle"
            },
            "web": {
              "workload": "source_mac_arm64_web",
              "request": {
                "units": [
                  "web"
                ]
              },
              "product": "bundle"
            },
            "shell": {
              "workload": "source_mac_arm64_shell",
              "request": {
                "units": [
                  "shell"
                ]
              },
              "product": "bundle"
            }
          }
        },
        "source_mac_x64": {
          "artifact": "beta-source-mac_x64",
          "entries": {
            "packages": {
              "workload": "source_mac_x64_packages",
              "request": {
                "units": [
                  "packages"
                ]
              },
              "product": "bundle"
            },
            "daemon": {
              "workload": "source_mac_x64_daemon",
              "request": {
                "units": [
                  "daemon"
                ]
              },
              "product": "bundle"
            },
            "web": {
              "workload": "source_mac_x64_web",
              "request": {
                "units": [
                  "web"
                ]
              },
              "product": "bundle"
            },
            "shell": {
              "workload": "source_mac_x64_shell",
              "request": {
                "units": [
                  "shell"
                ]
              },
              "product": "bundle"
            }
          }
        },
        "source_win_x64": {
          "artifact": "beta-source-win_x64",
          "entries": {
            "packages": {
              "workload": "source_win_x64_packages",
              "request": {
                "units": [
                  "packages"
                ]
              },
              "product": "bundle"
            },
            "daemon": {
              "workload": "source_win_x64_daemon",
              "request": {
                "units": [
                  "daemon"
                ]
              },
              "product": "bundle"
            },
