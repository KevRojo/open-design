      },
      "matrices": {
        "build": [
          {
            "target": "mac_arm64",
            "name": "[build] macOS arm64",
            "enabledInput": "enable_mac_arm64",
            "runner": "macos-14",
            "shell": "bash"
          },
          {
            "target": "mac_x64",
            "name": "[build] macOS x64",
            "enabledInput": "enable_mac_x64",
            "runner": "macos-15-intel",
            "shell": "bash"
          },
          {
            "target": "win_x64",
            "name": "[build] Windows x64",
            "enabledInput": "enable_win_x64",
            "runner": "windows-latest",
            "shell": "pwsh"
          },
          {
            "target": "linux_x64",
            "name": "[build] Linux x64",
            "enabledInput": "enable_linux_x64",
            "runner": "ubuntu-latest",
            "shell": "bash"
          }
        ],
        "test": [
          {
            "workload": "test_e2e_vitest",
            "kind": "e2e",
            "name": "[test] beta E2E Vitest",
            "timeout": 20,
            "prepare": "pnpm --filter @open-design/daemon build\npnpm --filter @open-design/desktop build\npnpm --filter @open-design/web build:sidecar",
            "command": "pnpm --filter @open-design/e2e test",
            "postinstall": "[\"tools/dev\",\"tools/pack\",\"tools/serve\",\"tools/release\"]"
          },
          {
            "workload": "test_verify",
            "kind": "verify",
            "name": "[test] beta Verify build (typecheck + tests)",
            "timeout": 360,
            "prepare": "pnpm --filter @open-design/daemon build\npnpm --filter @open-design/desktop build",
            "command": "pnpm -r --workspace-concurrency=4 --if-present run typecheck\npnpm guard",
            "postinstall": "[\"tools/dev\",\"tools/pack\",\"tools/serve\",\"tools/release\"]"
          },
          {
            "workload": "test_daemon_unit_tests",
            "kind": "daemon",
            "name": "[test] beta Daemon tests (1/4)",
            "timeout": 15,
            "prepare": "pnpm --filter '@open-design/daemon^...' --workspace-concurrency=4 --if-present run build",
            "command": "pnpm --filter @open-design/daemon test --shard=1/4",
            "postinstall": "[]",
            "shard": 1,
            "debug": "1"
          },
          {
            "workload": "test_daemon_unit_tests",
            "kind": "daemon",
            "name": "[test] beta Daemon tests (2/4)",
            "timeout": 15,
            "prepare": "pnpm --filter '@open-design/daemon^...' --workspace-concurrency=4 --if-present run build",
            "command": "pnpm --filter @open-design/daemon test --shard=2/4",
            "postinstall": "[]",
            "shard": 2,
            "debug": "1"
          },
          {
            "workload": "test_daemon_unit_tests",
            "kind": "daemon",
            "name": "[test] beta Daemon tests (3/4)",
            "timeout": 15,
            "prepare": "pnpm --filter '@open-design/daemon^...' --workspace-concurrency=4 --if-present run build",
            "command": "pnpm --filter @open-design/daemon test --shard=3/4",
            "postinstall": "[]",
            "shard": 3,
            "debug": "1"
          },
          {
            "workload": "test_daemon_unit_tests",
            "kind": "daemon",
            "name": "[test] beta Daemon tests (4/4)",
            "timeout": 15,
            "prepare": "pnpm --filter '@open-design/daemon^...' --workspace-concurrency=4 --if-present run build",
            "command": "pnpm --filter @open-design/daemon test --shard=4/4",
            "postinstall": "[]",
            "shard": 4,
            "debug": "1"
          },
          {
            "workload": "test_functional_e2e",
            "kind": "ui",
            "name": "[test] beta UI P0 (entry-settings)",
            "timeout": 45,
            "prepare": "pnpm --filter @open-design/daemon build\npnpm --filter @open-design/desktop build\npnpm --filter @open-design/web build:sidecar",
            "command": "pnpm -C e2e exec tsx scripts/playwright.ts run-ui-group entry-settings",
            "postinstall": "[\"tools/dev\"]",
            "group": "entry-settings",
            "extra": ""
          },
          {
            "workload": "test_functional_e2e",
            "kind": "ui",
            "name": "[test] beta UI P0 (project-workspace)",
            "timeout": 45,
            "prepare": "pnpm --filter @open-design/daemon build\npnpm --filter @open-design/desktop build\npnpm --filter @open-design/web build:sidecar",
            "command": "pnpm -C e2e exec tsx scripts/playwright.ts run-ui-group project-workspace",
            "postinstall": "[\"tools/dev\"]",
            "group": "project-workspace",
            "extra": ""
          },
          {
            "workload": "test_functional_e2e",
            "kind": "ui",
            "name": "[test] beta UI P0 (project-workspace-editor)",
            "timeout": 45,
            "prepare": "pnpm --filter @open-design/daemon build\npnpm --filter @open-design/desktop build\npnpm --filter @open-design/web build:sidecar",
            "command": "pnpm -C e2e exec tsx scripts/playwright.ts run-ui-group project-workspace-editor",
            "postinstall": "[\"tools/dev\"]",
            "group": "project-workspace-editor",
            "extra": ""
          },
          {
            "workload": "test_functional_e2e",
            "kind": "ui",
            "name": "[test] beta UI P0 (project-collab)",
            "timeout": 45,
            "prepare": "pnpm --filter @open-design/daemon build\npnpm --filter @open-design/desktop build\npnpm --filter @open-design/web build:sidecar",
            "command": "pnpm -C e2e exec tsx scripts/playwright.ts run-ui-group project-collab",
            "postinstall": "[\"tools/dev\"]",
            "group": "project-collab",
            "extra": ""
          },
          {
            "workload": "test_functional_e2e",
            "kind": "ui",
            "name": "[test] beta UI P0 (project-runtime)",
            "timeout": 45,
            "prepare": "pnpm --filter @open-design/daemon build\npnpm --filter @open-design/desktop build\npnpm --filter @open-design/web build:sidecar",
            "command": "pnpm -C e2e exec tsx scripts/playwright.ts run-ui-group project-runtime",
            "postinstall": "[\"tools/dev\"]",
            "group": "project-runtime",
            "extra": "pnpm -C e2e exec tsx scripts/playwright.ts run-ui-group critical-extras"
          },
          {
            "workload": "test_functional_e2e",
            "kind": "ui",
            "name": "[test] beta UI P0 (workspace-restoration)",
            "timeout": 45,
            "prepare": "pnpm --filter @open-design/daemon build\npnpm --filter @open-design/desktop build\npnpm --filter @open-design/web build:sidecar",
            "command": "pnpm -C e2e exec tsx scripts/playwright.ts run-ui-group workspace-restoration",
            "postinstall": "[\"tools/dev\"]",
            "group": "workspace-restoration",
            "extra": ""
          }
        ]
      }
    }
  }
}
