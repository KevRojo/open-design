        },
        "source_mac_x64_shell": {
          "successBoundary": "steps",
          "inputs": [
            "suite://source-shell"
          ],
          "runnerClass": "source_mac_x64",
          "products": "manifest",
          "reusable": true,
          "success": {
            "[build] macOS x64": [
              "[build] Source shell",
              "[retain] Source products"
            ]
          }
        },
        "source_win_x64_packages": {
          "successBoundary": "steps",
          "inputs": [
            "suite://source-packages"
          ],
          "runnerClass": "source_win_x64",
          "products": "manifest",
          "reusable": true,
          "success": {
