            ]
          }
        },
        "source_win_x64_web": {
          "successBoundary": "steps",
          "inputs": [
            "suite://source-web"
          ],
          "runnerClass": "source_win_x64",
          "products": "manifest",
          "reusable": true,
          "success": {
            "[build] Windows x64": [
              "[build] Source web",
