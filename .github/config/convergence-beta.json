{
  "schema": {"version": 7},
  "resources": {
    "repository-validation": {"paths": ["*"], "exclude": ["apps/packaged/package.json"]},
    "packaged-execution": {"json": "apps/packaged/package.json", "omit": ["version"]},
    "source-common": {
      "paths": [
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "packages/",
        "tools/pack/",
        "scripts/postinstall.mjs",
        ".github/scripts/release/workspace-products.ts",
        ".github/actions/setup-workspace/"
      ],
      "exclude": ["**/tests/**", "**/*.test.ts", "**/vitest.config.ts", "**/tsconfig.tests.json"]
    },
    "source-daemon": {
      "paths": ["apps/daemon/"],
      "exclude": ["**/tests/**", "**/*.test.ts", "**/vitest.config.ts", "**/tsconfig.tests.json"]
    },
    "source-web": {
      "paths": ["apps/web/"],
      "exclude": ["**/tests/**", "**/*.test.ts", "**/vitest.config.ts", "**/tsconfig.tests.json"]
    },
    "source-shell": {
      "paths": ["apps/desktop/", "apps/packaged/"],
      "exclude": ["**/tests/**", "**/*.test.ts", "**/vitest.config.ts", "**/tsconfig.tests.json", "apps/packaged/package.json"]
    }
  },
  "suites": {
    "repository-validation": ["resource://repository-validation", "resource://packaged-execution"],
    "convergence-control": [
      ".github/config/convergence-beta.json",
      ".github/scripts/convergence.py",
      ".github/scripts/handoff.py",
      ".github/scripts/lib/",
      ".github/workflows/convergence.atom.yml",
      ".github/workflows/release-beta.yml",
      ".github/actions/setup-workspace/"
    ],
    "source-packages": ["resource://source-common"],
    "source-daemon": ["resource://source-common", "resource://source-daemon"],
    "source-web": ["resource://source-common", "resource://source-web"],
    "source-shell": ["resource://source-common", "resource://source-shell", "resource://packaged-execution"]
  },
  "workflows": {
    "release-beta": {
      "policy": "beta-isolated-v1",
      "workloads": {
        "source_mac_arm64_packages": {
          "successBoundary": "steps",
          "inputs": ["suite://source-packages"],
          "runnerClass": "source_mac_arm64",
          "products": "manifest",
          "reusable": true,
          "success": {"[build] macOS arm64": ["[build] Source packages", "[retain] Source products"]}
        },
        "source_mac_arm64_daemon": {
          "successBoundary": "steps",
          "inputs": ["suite://source-daemon"],
          "runnerClass": "source_mac_arm64",
          "products": "manifest",
          "reusable": true,
          "success": {"[build] macOS arm64": ["[build] Source daemon", "[retain] Source products"]}
        },
        "source_mac_arm64_web": {
          "successBoundary": "steps",
          "inputs": ["suite://source-web"],
          "runnerClass": "source_mac_arm64",
          "products": "manifest",
          "reusable": true,
          "success": {"[build] macOS arm64": ["[build] Source web", "[retain] Source products"]}
        },
        "source_mac_arm64_shell": {
          "successBoundary": "steps",
          "inputs": ["suite://source-shell"],
          "runnerClass": "source_mac_arm64",
          "products": "manifest",
          "reusable": true,
          "success": {"[build] macOS arm64": ["[build] Source shell", "[retain] Source products"]}
        },
        "source_mac_x64_packages": {
          "successBoundary": "steps",
          "inputs": ["suite://source-packages"],
          "runnerClass": "source_mac_x64",
          "products": "manifest",
          "reusable": true,
          "success": {"[build] macOS x64": ["[build] Source packages", "[retain] Source products"]}
        },
        "source_mac_x64_daemon": {
          "successBoundary": "steps",
          "inputs": ["suite://source-daemon"],
          "runnerClass": "source_mac_x64",
          "products": "manifest",
          "reusable": true,
          "success": {"[build] macOS x64": ["[build] Source daemon", "[retain] Source products"]}
        },
        "source_mac_x64_web": {
          "successBoundary": "steps",
          "inputs": ["suite://source-web"],
          "runnerClass": "source_mac_x64",
          "products": "manifest",
          "reusable": true,
          "success": {"[build] macOS x64": ["[build] Source web", "[retain] Source products"]}
        },
        "source_mac_x64_shell": {
          "successBoundary": "steps",
          "inputs": ["suite://source-shell"],
          "runnerClass": "source_mac_x64",
          "products": "manifest",
          "reusable": true,
          "success": {"[build] macOS x64": ["[build] Source shell", "[retain] Source products"]}
        },
        "source_win_x64_packages": {
          "successBoundary": "steps",
          "inputs": ["suite://source-packages"],
          "runnerClass": "source_win_x64",
          "products": "manifest",
          "reusable": true,
          "success": {"[build] Windows x64": ["[build] Source packages", "[retain] Source products"]}
        },
        "source_win_x64_daemon": {
          "successBoundary": "steps",
          "inputs": ["suite://source-daemon"],
          "runnerClass": "source_win_x64",
          "products": "manifest",
          "reusable": true,
          "success": {"[build] Windows x64": ["[build] Source daemon", "[retain] Source products"]}
        },
        "source_win_x64_web": {
          "successBoundary": "steps",
          "inputs": ["suite://source-web"],
          "runnerClass": "source_win_x64",
          "products": "manifest",
          "reusable": true,
          "success": {"[build] Windows x64": ["[build] Source web", "[retain] Source products"]}
        },
        "source_win_x64_shell": {
          "successBoundary": "steps",
          "inputs": ["suite://source-shell"],
          "runnerClass": "source_win_x64",
          "products": "manifest",
          "reusable": true,
          "success": {"[build] Windows x64": ["[build] Source shell", "[retain] Source products"]}
        },
        "test_e2e_vitest": {
          "inputs": ["suite://repository-validation"],
          "runnerClass": "release_tests",
          "products": "none",
          "reusable": true,
          "success": {"[test] beta E2E Vitest": ["Prebuild workspace type declarations", "Run E2E Vitest"]}
        },
        "test_daemon_unit_tests": {
          "inputs": ["suite://repository-validation"],
          "runnerClass": "release_tests",
          "products": "none",
          "reusable": true,
          "success": {
            "[test] beta Daemon tests (1/4)": ["Run daemon test shard"],
            "[test] beta Daemon tests (2/4)": ["Run daemon test shard"],
            "[test] beta Daemon tests (3/4)": ["Run daemon test shard"],
            "[test] beta Daemon tests (4/4)": ["Run daemon test shard"]
          }
        },
        "test_verify": {
          "inputs": ["suite://repository-validation"],
          "runnerClass": "release_tests",
          "products": "none",
          "reusable": true,
          "success": {
            "[test] beta Verify build (typecheck + tests)": [
              "Build daemon and desktop (typecheck dependencies)",
              "Typecheck workspaces",
              "Check repository layout policies"
            ]
          }
        },
        "test_functional_e2e": {
          "inputs": ["suite://repository-validation"],
          "runnerClass": "ui_p0",
          "products": "none",
          "reusable": true,
          "success": {
            "[test] beta P0 Functional E2E / UI P0 (entry-settings)": ["Prebuild workspace type declarations", "Run UI P0 domain"],
            "[test] beta P0 Functional E2E / UI P0 (project-workspace)": ["Prebuild workspace type declarations", "Run UI P0 domain"],
            "[test] beta P0 Functional E2E / UI P0 (project-workspace-editor)": ["Prebuild workspace type declarations", "Run UI P0 domain"],
            "[test] beta P0 Functional E2E / UI P0 (project-collab)": ["Prebuild workspace type declarations", "Run UI P0 domain"],
            "[test] beta P0 Functional E2E / UI P0 (project-runtime)": ["Prebuild workspace type declarations", "Run UI P0 domain", "Run UI critical extras"],
            "[test] beta P0 Functional E2E / UI P0 (workspace-restoration)": ["Prebuild workspace type declarations", "Run UI P0 domain"]
          }
        }
      },
      "batches": {
        "source_mac_arm64": {
          "artifact": "beta-source-mac_arm64",
          "entries": {
            "packages": {"workload": "source_mac_arm64_packages", "request": {"units": ["packages"]}, "product": "bundle"},
            "daemon": {"workload": "source_mac_arm64_daemon", "request": {"units": ["daemon"]}, "product": "bundle"},
            "web": {"workload": "source_mac_arm64_web", "request": {"units": ["web"]}, "product": "bundle"},
            "shell": {"workload": "source_mac_arm64_shell", "request": {"units": ["shell"]}, "product": "bundle"}
          }
        },
        "source_mac_x64": {
          "artifact": "beta-source-mac_x64",
          "entries": {
            "packages": {"workload": "source_mac_x64_packages", "request": {"units": ["packages"]}, "product": "bundle"},
            "daemon": {"workload": "source_mac_x64_daemon", "request": {"units": ["daemon"]}, "product": "bundle"},
            "web": {"workload": "source_mac_x64_web", "request": {"units": ["web"]}, "product": "bundle"},
            "shell": {"workload": "source_mac_x64_shell", "request": {"units": ["shell"]}, "product": "bundle"}
          }
        },
        "source_win_x64": {
          "artifact": "beta-source-win_x64",
          "entries": {
            "packages": {"workload": "source_win_x64_packages", "request": {"units": ["packages"]}, "product": "bundle"},
            "daemon": {"workload": "source_win_x64_daemon", "request": {"units": ["daemon"]}, "product": "bundle"},
            "web": {"workload": "source_win_x64_web", "request": {"units": ["web"]}, "product": "bundle"},
            "shell": {"workload": "source_win_x64_shell", "request": {"units": ["shell"]}, "product": "bundle"}
          }
        }
      }
    }
  }
}
